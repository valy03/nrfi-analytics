# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real secrets.

# --- Database (docker-compose sets this automatically for the backend
#     container — only needed here if running the backend outside Docker) ---
DATABASE_URL=postgresql://nrfi:nrfi@localhost:5432/nrfi_analytics

# --- Weather (research.md: OpenWeather free tier) ---
OPENWEATHER_API_KEY=

# --- Odds (research.md: The Odds API free tier — display-only, not a
#     model input, see research.md Data Source Decisions) ---
ODDS_API_KEY=

ENVIRONMENT=development
